# 이 파일을 복사해서 .env 로 이름 바꾸고 실제 값으로 채우세요.
# .env 파일은 git에 올리지 마세요 (토큰/키 노출 위험).

# Discord 개발자 포털 > Bot > Reset Token 에서 발급
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# console.anthropic.com > API Keys 에서 발급
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 봇이 반응할 채널 이름들 (쉼표로 구분, # 은 빼고 적기)
TARGET_CHANNEL_NAMES=business,business-2

# 사용할 Claude 모델 (기본값 그대로 두는 걸 권장)
CLAUDE_MODEL=claude-opus-5-5
